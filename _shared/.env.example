# ════════════════════════════════════════════════════════════════════════════
# Course-wide environment template
# ════════════════════════════════════════════════════════════════════════════
# This is the canonical reference for every .env file in the course. Each
# project directory has its own .env.example with project-specific keys,
# but the provider section is identical everywhere.
#
# Copy this to .env (or copy a project-local .env.example) and fill in your
# keys. See course/_shared/README.md for the full setup guide.
# ════════════════════════════════════════════════════════════════════════════

LLM_PROVIDER=openai   # "openai" (default) or "minimax"

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini   # default if unset

# ── MiniMax M3 ───────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=minimax. Get a key from your MiniMax account.
# MINIMAX_API_KEY=sk-your-minimax-key
# MINIMAX_MODEL=MiniMax-M3                                            # default
# MINIMAX_BASE_URL=https://api.minimax.io/v1                           # default

# ── Common LLM tuning ────────────────────────────────────────────────────────
TEMPERATURE=0.3
MAX_TOKENS=1024

# ── Provider observability ───────────────────────────────────────────────────
# Prints one compact provider line to stderr whenever a chat model is created.
LLM_PROVIDER_OBSERVABILITY=true

# ════════════════════════════════════════════════════════════════════════════
# LangSmith (optional — for tracing and evaluation)
# ════════════════════════════════════════════════════════════════════════════
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-agent-engineer